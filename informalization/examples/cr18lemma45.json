        {"prov": null, "latex": "\\tau'", "kind": "math"},
        {"s": " on the left side results in ", "kind": "text"},
        {"prov": null,
         "latex": "\\tau' \\tau p \\le \\tau' q \\rho",
         "kind": "math"},
        {"s": ", since ", "kind": "text"},
