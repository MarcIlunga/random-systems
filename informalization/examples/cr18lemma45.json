        {"type": "", "name": "τ' is ≤-respecting", "changed": false}],
       "goal": "\\tau' \\tau p \\le \\tau' q \\rho"},
      "anchor":
      {"xs":
       [{"s": "Composing both sides of ", "kind": "text"},
        {"prov": null, "latex": "\\tau p \\le q \\rho", "kind": "math"},
