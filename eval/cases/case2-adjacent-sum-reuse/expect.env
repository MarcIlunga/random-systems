# Case 2 — chain bound: reuse the existing general lemma, or hand-roll it?
#
# Ground truth is a one-liner:
#   AdjacentMaxAdvantageBounded.traceBound hstep
# verified against the tree. The naive route is an induction over the chain or a
# fold of maxAdvantage_triangle — which is exactly the re-derivation this case
# measures. `sequence-hash/PLAN.md` §3b names this very lemma as one people
# re-mint instead of reusing.

TARGET_SRC="eval/cases/case2-adjacent-sum-reuse/Fixture.lean"
TARGET_DECL="RandomSystems.CR18.Complexity.Eval.chain_bound"

# Either the statement-form wrapper or the underlying lemma counts as reuse;
# `traceBound` reaches `maxAdvantage_le_adjacent_sum`, so assert the latter.
EXPECT_DEP="RandomSystems.CR18.Complexity.maxAdvantage_le_adjacent_sum"

# A hand-rolled chain bottoms out in the raw triangle inequality instead.
FORBID_DEP="RandomSystems.CR18.maxAdvantage_triangle"

EXPECT_AXIOM_CLEAN=1

# The reference solution adds nothing. Any helper here is a re-derivation.
MAX_NEW_DECLS=0

EXPECT_ARTIFACTS=1
